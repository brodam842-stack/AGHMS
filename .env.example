# ============================================================
# AGHMS — Environment Configuration (template)
# Copy this file to `.env` and fill in your values.
# ============================================================
# Vite only exposes variables prefixed with VITE_ to the browser.

# ── Supabase (frontend) ─────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Admission Consultancy portal (2nd Supabase project, read-only) ──
# Source for the "faculty wise consultation" agenda auto-migration.
VITE_CONSULT_SUPABASE_URL=https://YOUR-CONSULT-PROJECT-REF.supabase.co
VITE_CONSULT_SUPABASE_ANON_KEY=consult-project-anon-key

# ── AI Provider: OpenRouter ─────────────────────────────────
# The app calls OpenRouter via the `openrouter-proxy` Edge Function.
# Only the model slug is a frontend value:
VITE_OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# ── Server-side secrets (NOT read by Vite) ──────────────────
# Set these as Supabase Edge Function secrets, not in this file:
#   OPENROUTER_API_KEY   → used by the openrouter-proxy function
#   RESEND_API_KEY       → used by the send-email function
#   RESEND_FROM_EMAIL    → e.g. "AGHMS <noreply@yourdomain>"
#   APP_URL              → e.g. https://aghms.rngpitai.in
